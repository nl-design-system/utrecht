{
  "version": "0.0.2",
  "author": "Community for NL Design System",
  "description": "Utrecht Design System website",
  "license": "EUPL-1.2",
  "name": "@utrecht/design-system-website",
  "keywords": [
    "nl-design-system"
  ],
  "files": [
    "dist"
  ],
  "private": true,
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/utrecht.git",
    "directory": "packages/design-system-website"
  },
  "devDependencies": {
    "@utrecht/astro": "workspace:*",
    "@utrecht/docusaurus": "workspace:*",
    "@utrecht/storybook": "workspace:*",
    "@utrecht/storybook-angular": "workspace:*",
    "@utrecht/storybook-css": "workspace:*",
    "@utrecht/storybook-html": "workspace:*",
    "@utrecht/storybook-pdf": "workspace:*",
    "@utrecht/storybook-react": "workspace:*",
    "@utrecht/storybook-vue": "workspace:*",
    "@utrecht/storybook-web-component": "workspace:*",
    "cpy-cli": "7.0.0",
    "rimraf": "5.0.10"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "build": "pnpm run clean && pnpm run '/^build:.*/'",
    "build:astro": "cpy '../astro/dist/**' dist/",
    "build:docusaurus": "rimraf dist/docusaurus/ && cpy '../docusaurus/build/**' dist/docusaurus/",
    "build:stencil": "rimraf dist/stencil/ && cpy '../web-component-library-stencil/www/**' dist/stencil/",
    "build:storybook": "rimraf dist/storybook/ && cpy '../storybook/dist/**' dist/storybook/",
    "build:storybook-angular": "rimraf dist/storybook-angular/ && cpy '../storybook-angular/dist/**' dist/storybook-angular/",
    "build:storybook-css": "rimraf dist/storybook-css/ && cpy '../storybook-css/dist/**' dist/storybook-css/",
    "build:storybook-html": "rimraf dist/storybook-html/ && cpy '../storybook-html/dist/**' dist/storybook-html/",
    "build:storybook-pdf": "rimraf dist/storybook-pdf/ && cpy '../storybook-pdf/dist/**' dist/storybook-pdf/",
    "build:storybook-react": "rimraf dist/storybook-react/ && cpy '../storybook-react/dist/**' dist/storybook-react/",
    "build:storybook-vue": "rimraf dist/storybook-vue/ && cpy '../storybook-vue/dist/**' dist/storybook-vue/",
    "build:storybook-web-component": "rimraf dist/storybook-web-component/ && cpy '../storybook-web-component/dist/**' dist/storybook-web-component/",
    "start": "http-server dist/"
  }
}
