---
/**
 * Status en links naar npm, Storybook en GitHub voor elk framework met een story van de component, daarna Figma.
 */
import { getLinks, type LinkIcon } from '../utils/storybook/index.ts';

interface Props {
  /** Componentnaam zoals in de titels van de stories, bijvoorbeeld `Accordion` */
  component: string;
}

const { component } = Astro.props;
const links = getLinks(component);

// Merkiconen uit Tabler Icons 2.44 (MIT), https://tabler.io/icons
const icons: Record<LinkIcon, string[]> = {
  npm: ['M1 8h22v7h-12v2h-4v-2h-6z', 'M7 8v7', 'M14 8v7', 'M17 11v4', 'M4 11v4', 'M11 11v1', 'M20 11v4'],
  storybook: [
    'M5 4l.5 16.5l13.5 .5v-18z',
    'M9 15c.6 1.5 1.639 2 3.283 2h-.283c1.8 0 3 -.974 3 -2.435c0 -1.194 -.831 -1.799 -2.147 -2.333l-1.975 -.802c-1.15 -.467 -1.878 -1.422 -1.878 -2.467c0 -.97 .899 -1.786 2.087 -1.893l.613 -.055c1.528 -.138 3 .762 3.3 1.985',
    'M16 3.5v1',
  ],
  github: [
    'M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5',
  ],
  figma: [
    'M15 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0',
    'M6 3m0 3a3 3 0 0 1 3 -3h6a3 3 0 0 1 3 3v0a3 3 0 0 1 -3 3h-6a3 3 0 0 1 -3 -3z',
    'M9 9a3 3 0 0 0 0 6h3m-3 0a3 3 0 1 0 3 3v-15',
  ],
};
---

{
  links.length > 0 && (
    <ul class="utrecht-component-links" role="list">
      {links.map(({ prefix, href, label, icon, framework }) => (
        <li class="utrecht-component-links__item" data-framework={framework}>
          {prefix && <span>{prefix}</span>}
          <a class="utrecht-link utrecht-component-links__link" href={href}>
            {icon && (
              <svg
                class="utrecht-component-links__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {icons[icon].map((d) => (
                  <path d={d} />
                ))}
              </svg>
            )}
            {label}
          </a>
        </li>
      ))}
    </ul>
  )
}

<script>
  // Toon de links van het framework dat in de codetabs gekozen is. Links van een framework zonder tab en de Figma-links
  // blijven staan. Zonder codetabs, of zonder JavaScript, staan alle links er.
  const code = document.querySelector<HTMLElement>('.utrecht-code-example[data-frameworks]');
  const frameworks = code?.dataset['frameworks']?.split(' ') ?? [];
  const update = () => {
    // Met één tab is er geen tablijst: dan is dat ene framework gekozen
    const selected =
      code?.querySelector<HTMLElement>('[role="tab"][aria-selected="true"]')?.dataset['value'] ?? frameworks[0];
    for (const item of document.querySelectorAll<HTMLElement>('.utrecht-component-links__item[data-framework]')) {
      const framework = item.dataset['framework']!;
      item.hidden = Boolean(selected) && frameworks.includes(framework) && framework !== selected;
    }
  };
  code?.addEventListener('utrecht-code-example-select', update);
  update();
</script>

<style>
  .utrecht-component-links {
    display: grid;
    gap: var(--utrecht-space-block-md, 1rem);
    list-style: none;
    margin-block: var(--utrecht-space-block-lg, 1.5rem);
    padding-inline-start: 0;
  }

  .utrecht-component-links__item {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--utrecht-space-inline-xs, 0.25rem);
  }

  .utrecht-component-links__item[hidden] {
    display: none;
  }

  /* Het icoon hoort bij de link, dus het heeft dezelfde kleur en hetzelfde doel */
  .utrecht-component-links__link {
    align-items: center;
    display: inline-flex;
    gap: var(--utrecht-space-inline-sm, 0.5rem);
  }

  .utrecht-component-links__icon {
    block-size: 1.5em;
    flex: none;
    inline-size: 1.5em;
  }
</style>
