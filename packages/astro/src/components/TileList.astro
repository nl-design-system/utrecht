---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["utrecht-tile-list", className]}>
  <slot />
</div>

<style>
  .utrecht-tile-list {
    display: grid;
    gap: 24px;

    /* minmax(0, 1fr): een kolom mag smaller worden dan zijn inhoud, anders wordt de pagina breder dan het venster */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block: 0;
    margin-inline: 0;
    padding-block: 0;
    padding-inline: 0;
  }

  /* Eén kolom op een smal scherm (WCAG 1.4.10) */
  @media (width < 40rem) {
    .utrecht-tile-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

