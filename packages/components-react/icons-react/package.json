{
  "name": "@utrecht/icons-react",
  "version": "0.0.0",
  "description": "Icons for the Municipality of Utrecht as React components, based on the NL Design System architecture",
  "keywords": [
    "nl-design-system"
  ],
  "homepage": "https://github.com/nl-design-system/utrecht/tree/main/packages/components-react/icons-react#readme",
  "bugs": {
    "url": "https://github.com/nl-design-system/utrecht/issues"
  },
  "repository": {
    "type": "git+ssh",
    "url": "git+https://github.com/nl-design-system/utrecht.git",
    "directory": "packages/components-react/icons-react"
  },
  "license": "EUPL-1.2",
  "author": "Community for NL Design System",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/generated/icons/*.d.ts",
      "import": "./dist/generated/icons/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist *.tsbuildinfo coverage",
    "test": "jest --coverage --verbose",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/testing-library__jest-dom": "5.14.9",
    "@utrecht/icon": "workspace:*",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
