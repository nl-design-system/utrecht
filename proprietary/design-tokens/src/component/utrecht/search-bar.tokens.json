{
  "utrecht": {
    "search-bar": {
      "input": {
        "background-position-x": { "$value": ".5em" },
        "background-position-y": { "$value": "50%" },
        "background-size": { "$value": "1em" },
        "border-color": { "$value": "{utrecht.color.red.40}" },
        "border-width": { "$value": "{utrecht.border-width.md}" },
        "active": {
          "border-color": { "$value": "hsl(0 100% 25%)" }
        },
        "focus": {
          "border-color": { "$value": "hsl(0 100% 25%)" }
        },
        "inline-size": { "$value": "300px" },
        "small": {
          "inline-size": { "$value": "200px" }
        },
        "padding-inline-start": { "$value": "{utrecht.space.inline.xs}" },
        "border-bottom-width": {},
        "max-inline-size": {},
        "background-image": {}
      },
      "button": {
        "active": {
          "background-color": { "$value": "hsl(0 100% 25%)" },
          "border-color": { "$value": "hsl(0 100% 25%)" },
          "color": { "$value": "{utrecht.color.white}" }
        },
        "background-color": { "$value": "hsl(0 100% 40%)" },
        "border-color": { "$value": "hsl(0 100% 40%)" },
        "border-end-end-radius": { "$value": "5px" },
        "border-start-end-radius": { "$value": "5px" },
        "column-gap": { "$value": "{utrecht.space.inline.xs}" },
        "color": { "$value": "{utrecht.color.white}" },
        "font-size": { "$value": "{utrecht.typography.scale.sm.font-size}" },
        "font-weight": { "$value": "{utrecht.typography.weight-scale.bold.font-weight}" },
        "icon": {
          "size": { "$value": "24px" }
        },
        "focus": {
          "background-color": { "$value": "{utrecht.focus.background-color}" },
          "border-color": { "$value": "hsl(0 100% 25%)" },
          "color": { "$value": "{utrecht.color.black}" }
        },
        "hover": {
          "background-color": { "$value": "hsl(0 100% 31%)" },
          "border-color": { "$value": "hsl(0 100% 31%)" },
          "color": { "$value": "{utrecht.color.white}" },
          "scale": { "$value": "1" }
        },
        "padding-inline-end": { "$value": "{utrecht.space.inline.xl}" },
        "padding-inline-start": { "$value": "{utrecht.space.inline.xl}" }
      },
      "dropdown": {
        "inline-size": {},
        "z-index": {},
        "border-width": {
          "$value": "1px"
        },
        "border-color": {
          "$value": "{utrecht.color.red.40}"
        },
        "padding-block-start": {
          "$value": "{utrecht.space.block.xs}"
        },
        "padding-block-end": {
          "$value": "{utrecht.space.block.xs}"
        },
        "padding-inline-start": {},
        "padding-inline-end": {},
        "max-block-size": {
          "$value": "300px"
        }
      },
      "section": {
        "margin-block-end": {
          "$value": "{utrecht.space.inline.xs}"
        },
        "title": {
          "font-size": {
            "$value": "{utrecht.typography.scale.md.font-size}"
          },
          "font-weight": {
            "$value": "{utrecht.typography.weight-scale.bold.font-weight}"
          },
          "line-height": {},
          "color": {
            "$value": "{utrecht.color.black}"
          },
          "margin-inline-start": {
            "$value": "{utrecht.space.inline.xs}"
          }
        }
      },
      "list-item": {
        "padding-inline-start": {},
        "padding-inline-end": {},
        "padding-block-start": {},
        "padding-block-end": {},
        "is-active": {
          "color": {
            "$value": "{utrecht.color.black}"
          },
          "background-color": {
            "$value": "{utrecht.color.grey.95}"
          },
          "font-weight": {
            "$value": "{utrecht.typography.weight-scale.bold.font-weight}"
          }
        },
        "is-selected": {
          "color": {
            "$value": "{utrecht.color.black}"
          },
          "background-color": {
            "$value": "{utrecht.color.grey.95}"
          }
        }
      }
    }
  }
}
